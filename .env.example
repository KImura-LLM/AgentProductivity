# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Notion
NOTION_TOKEN=
NOTION_VERSION=2025-09-03

# Prefer NOTION_DATABASES_JSON for multiple task/project databases.
# Example:
# NOTION_DATABASES_JSON={"databases":[{"name":"Work Tasks","data_source_id":"replace-with-notion-data-source-id","type":"tasks","area":"work"}]}
NOTION_DATABASES_JSON=

# Legacy single-database setup.
NOTION_TASKS_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=

# TickTick OAuth
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://127.0.0.1:8765/callback
TICKTICK_ACCESS_TOKEN=
TICKTICK_REFRESH_TOKEN=

# Schedule and timezone
TIMEZONE=Europe/Moscow
MORNING_BRIEFING_TIME=07:30
EVENING_REVIEW_TIME=21:00
WEEKLY_REVIEW_TIME=10:00
OVERDUE_CHECK_TIME=12:00

# Effectiveness tracking
TARGET_SLEEP_TIME=23:30
TARGET_WAKE_TIME=07:30
WIND_DOWN_TIME=22:45
WORK_SHUTDOWN_TIME=21:30

# Local state and logging
APP_STATE_PATH=.state/agent-state.json
LOG_LEVEL=INFO
